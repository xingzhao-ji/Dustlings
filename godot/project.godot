; Dustlings — real 3D courtyard development milestone.
config_version=5

[application]
config/name="Dustlings 3D"
config/version="0.4.0-dev"
config/icon="res://assets/ui/app-icon.svg"
run/main_scene="res://scenes/courtyard.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/description="An original miniature restoration game. 3D courtyard in development."
config/use_custom_user_dir=true
config/custom_user_dir_name="Dustlings3D"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/size/min_width=960
window/size/min_height=640
window/stretch/mode="canvas_items"

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
textures/default_filters/anisotropic_filtering_level=2

audio/driver/enable_input=false

renderer/rendering_method.web="gl_compatibility"
rendering_device/driver.macos="metal"
